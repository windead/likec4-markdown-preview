    c1 -> c2 'uses'
    c2 -> c3 'uses'
    c3 -> c4 'uses'
    c4 -> c5 'uses'
  }
  user -> sys1.c1 'uses'
  sys1.c5 -> sys2.c1 'integrates'
  sys1.c2.k2 -> sys5.c3.k1 'queries'
  sys2.c5 -> sys3.c1 'integrates'
  sys2.c2.k2 -> sys6.c3.k1 'queries'
  sys3.c5 -> sys4.c1 'integrates'
  sys3.c2.k2 -> sys7.c3.k1 'queries'
  sys4.c5 -> sys5.c1 'integrates'
  sys4.c2.k2 -> sys8.c3.k1 'queries'
  sys5.c5 -> sys6.c1 'integrates'
  sys5.c2.k2 -> sys9.c3.k1 'queries'
  sys6.c5 -> sys7.c1 'integrates'
  sys6.c2.k2 -> sys10.c3.k1 'queries'
  sys7.c5 -> sys8.c1 'integrates'
  sys7.c2.k2 -> sys11.c3.k1 'queries'
  sys8.c5 -> sys9.c1 'integrates'
  sys8.c2.k2 -> sys12.c3.k1 'queries'
  sys9.c5 -> sys10.c1 'integrates'
  sys9.c2.k2 -> sys1.c3.k1 'queries'
  sys10.c5 -> sys11.c1 'integrates'
  sys10.c2.k2 -> sys2.c3.k1 'queries'
  sys11.c5 -> sys12.c1 'integrates'
  sys11.c2.k2 -> sys3.c3.k1 'queries'
}

deployment {
  environment prod 'Production' {
    node n1 'Node 1' {
      instanceOf sys1.c1
      instanceOf sys1.c2
      instanceOf sys1.c3
    }
    node n2 'Node 2' {
      instanceOf sys2.c1
      instanceOf sys2.c2
      instanceOf sys2.c3
    }
    node n3 'Node 3' {
      instanceOf sys3.c1
      instanceOf sys3.c2
      instanceOf sys3.c3
    }
    node n4 'Node 4' {
      instanceOf sys4.c1
      instanceOf sys4.c2
      instanceOf sys4.c3
    }
  }
}

